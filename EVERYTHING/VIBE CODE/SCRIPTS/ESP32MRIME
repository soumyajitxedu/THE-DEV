#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <Preferences.h>

#define SCREEN_W 128
#define SCREEN_H 64
#define OLED_ADDR 0x3C
#define SDA_PIN 21
#define SCL_PIN 22

#define BTN_UP     32
#define BTN_DOWN   33
#define BTN_LEFT   25
#define BTN_RIGHT  26
#define BTN_SELECT 27

const uint8_t BTN_PINS[5] = {BTN_UP, BTN_DOWN, BTN_LEFT, BTN_RIGHT, BTN_SELECT};
const unsigned long DEBOUNCE_MS   = 40;
const unsigned long LONG_PRESS_MS = 1200;

#define ARR_LEN(arr) (sizeof(arr) / sizeof((arr)[0]))

// ============================================================
//  TYPES
// ============================================================
enum Act { A_NONE, A_UP, A_DOWN, A_LEFT, A_RIGHT, A_SELECT, A_BACK, A_ALT };

struct Btn {
  bool stable = HIGH;
  bool lastRead = HIGH;
  unsigned long lastChange = 0;
  unsigned long pressStart = 0;
  bool longFired = false;
  bool shortPressed = false;
  bool longPressed = false;
};

struct Settings {
  uint8_t  brightness = 3;
  uint32_t menuTimeoutMs = 20000;
  bool     wallpaperOnBoot = true;
  bool     screenFlip = false;
};

Adafruit_SSD1306 display(SCREEN_W, SCREEN_H, &Wire, -1);
Preferences prefs;

Btn btn[5];
Settings cfg;
unsigned long lastActivity = 0;

// ============================================================
//  SAFE STRING HELPERS
// ============================================================
static void pgmCopyTrunc(char* dest, size_t destSize, const char* pgmSrc) {
  if (destSize == 0) return;
  strncpy_P(dest, pgmSrc, destSize - 1);
  dest[destSize - 1] = 0;
}

static int wrapText(const char* src, char out[][24], int maxLines, int maxCols) {
  int line = 0, col = 0;
  out[0][0] = 0;
  const char* p = src;
  int wrapAt   = maxCols - 3;
  int softWrap = maxCols - 6;

  while (*p && line < maxLines) {
    if (col >= wrapAt || *p == '\n') {
      out[line][col] = 0;
      line++;
      col = 0;
      if (*p == '\n') p++;
      if (line < maxLines) out[line][0] = 0;
      continue;
    }
    if (col > 0 && *p == ' ' && *(p + 1) && col >= softWrap) {
      out[line][col] = 0;
      line++;
      col = 0;
      if (line < maxLines) out[line][0] = 0;
      p++;
      continue;
    }
    out[line][col++] = *p++;
  }
  if (line < maxLines) {
    out[line][col] = 0;
    line++;
  }
  return line;
}

